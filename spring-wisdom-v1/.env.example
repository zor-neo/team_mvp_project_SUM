# Spring Wisdom V1 environment example
# Copy these values into your hosting provider's environment variable panel.
# Do not commit real secrets.

# local = demo session data allowed
# production = Supabase DB is required and demo fallback is disabled
APP_ENV=production

# Supabase Postgres
SUPABASE_DB_DSN=pgsql:host=YOUR_SUPABASE_DB_HOST;port=5432;dbname=postgres;sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Supabase Storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=content-files

# Optional hidden Gemini seeding tool
DEV_AI_SEED_KEY=CHANGE_THIS_LOCAL_SECRET
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
